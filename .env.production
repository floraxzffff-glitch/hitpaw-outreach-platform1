# 生产环境配置
# 部署到服务器时，请修改以下配置

# API 地址（浏览器访问的地址）
# 格式：http://你的服务器IP:8000 或 http://你的域名:8000
# 如果使用 nginx 反向代理，可以设置为 /api（相对路径）
NEXT_PUBLIC_API_URL=http://192.168.50.214:8000

# 数据库配置（后端使用）
DATABASE_URL=postgresql://vikpea:vikpea123@db:5432/vikpea

# Redis 配置（后端使用）
REDIS_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1
CELERY_RESULT_BACKEND=redis://cache:6379/2
