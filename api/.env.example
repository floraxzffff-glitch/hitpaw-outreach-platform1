"""
.env 环境变量配置文件（示例）
复制本文件为 .env 并填入实际值
"""

# ======================== 应用基础设置 ========================
APP_NAME=VikPea SEO API
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development

# ======================== 服务器配置 ========================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ======================== 数据库配置 ========================
# 可选：支持 SQLite、PostgreSQL、MySQL 等
# DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=postgresql://user:password@localhost/vikpea
DATABASE_URL=sqlite:///./data/vikpea.db
DATABASE_ECHO=true

# ======================== Redis 缓存配置 ========================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ======================== 邮箱服务配置（来自原 VikPea 配置） ========================
SMTP_SERVER=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-smtp-password

IMAP_SERVER=imap.qiye.aliyun.com
IMAP_PORT=993
IMAP_USER=your-email@company.com
IMAP_PASSWORD=your-imap-password

# ======================== 搜索 API 配置 ========================
# YouTube API（可选，如果使用 YouTube 搜索）
YOUTUBE_API_KEY=your_youtube_api_key_here

# Serper API（Google 搜索）
SERPER_API_KEY=your_serper_api_key_here

# SerpAPI（备选搜索 API）
SERPAPI_KEY=your_serpapi_key_here

# ======================== 文件上传配置 ========================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=.xlsx,.csv,.xls,.txt

# ======================== 安全配置 ========================
SECRET_KEY=your-super-secret-key-change-this-in-production-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================== CORS 配置 ========================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ======================== 日志配置 ========================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ======================== 后台任务配置（Celery） ========================
ENABLE_BACKGROUND_TASKS=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ======================== 速率限制配置 ========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ======================== 错误追踪配置（可选） ========================
# SENTRY_DSN=https://xxxxxxxxxxxxx@o000000.ingest.sentry.io/000000

# ======================== 其他配置 ========================
# 是否启用 API 文档（/docs）
ENABLE_API_DOCS=true

# 邮件发送的"发件人"名称
FROM_NAME=VikPea 外联工作台

# 代理设置（如果需要通过代理访问网络）
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
